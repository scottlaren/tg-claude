# Telegram bot token from @BotFather (Threaded Mode on)
TG_TOKEN=
# Telegram user ids allowed to use the bot, comma separated
OWNER_IDS=
# One key per device: id=key,id=key. Remove a pair to revoke the device
DEVICE_KEYS=pc=change-me
# Gateway for device connections (behind a TLS proxy on the VPS)
WS_HOST=127.0.0.1
WS_PORT=8787
# Optional
# DATA_DIR=data
# CLAUDE_PROFILE_DIR=data/profiles/main
# CLAUDE_MODEL=opus          (default for topics with a project)
# CLAUDE_CHAT_MODEL=sonnet    (default for "No project" topics)
# API_TIMEOUT_SEC=60
# Voice and video, handled on the server: ffmpeg/ffprobe and whisper.cpp from PATH unless set here
# WHISPER_BIN=
# WHISPER_MODEL=data/models/ggml-large-v3-turbo-q5_0.bin
# VOICE_LANGUAGE=ru   (default: the bot's language; auto detects it for each message, about twice as slow)
# WHISPER_THREADS=
# FFMPEG_BIN=
# FFPROBE_BIN=
# Claude turns at once across all topics (§14). Apps run on the computers; on the server each turn is
# one Claude Code process, ~0.2–0.4 GB: 8 GB VPS ≈ 8–10, 4 GB ≈ 4
# MAX_PARALLEL=2
# Daily encrypted backup of topics, devices and Claude profiles (§16): npm run backup -- key
# BACKUP_KEY=
# BACKUP_DIR=backups
# Cloud workspace (deploy/compose.yml, the installer sets these): the container connects with this key,
# COMPOSE_PROFILES=cloud turns it on, CLOUD_MEMORY / CLOUD_CPUS cap it
# CLOUD_KEY=
# COMPOSE_PROFILES=cloud
# CLOUD_MEMORY=2g
# A topic nobody writes in for this many days is deleted with its conversation on the server, after a
# warning a day ahead with a button to keep it; 0 keeps topics forever. /delete removes one right away
# TOPIC_TTL_DAYS=7
